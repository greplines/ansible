[server]
hostname = "{{ inventory_hostname }}"
node_ip = "{{ localhost_ip }}"
server_role = "default"
base_path = "${carbon.protocol}://${carbon.host}:${carbon.management.port}"
#discard_empty_caches = false

[super_admin]
username = "{{ admin_username }}"
password = "{% if secure_vault_enabled|bool %}$secret{admin_password}{% else %}{{ admin_password }}{% endif %}"
create_admin_account = true

[user_store]
type = "database_unique_id"

[database.apim_db]
type = "{{ wso2am_db_type }}"
url = "{{ wso2am_db_url }}"
hostname = "{{ wso2am_db_hostname }}"
name = "{{ wso2am_db_name }}"
port = "{{ wso2am_db_port }}"
username = "{% if secure_vault_enabled|bool %}$secret{wso2am_db_username}{% else %}{{ wso2am_db_username }}{% endif %}"
password = "{% if secure_vault_enabled|bool %}$secret{wso2am_db_password}{% else %}{{ wso2am_db_password }}{% endif %}"
driver = "{{ wso2am_db_driver }}"
validationQuery = "{{ wso2am_db_validationQuery }}"

[database.shared_db]
type = "{{ shared_db_type }}"
url = "{{ shared_db_url }}"
hostname = "{{ shared_db_hostname }}"
port = "{{ shared_db_port }}"
name = "{{ shared_db_name }}"
username = "{% if secure_vault_enabled|bool %}$secret{shared_db_username}{% else %}{{ shared_db_username }}{% endif %}"
password = "{% if secure_vault_enabled|bool %}$secret{shared_db_password}{% else %}{{ shared_db_password }}{% endif %}"
driver = "{{ shared_db_driver }}"
validationQuery = "{{shared_db_validationQuery}}"

[keystore.tls]
file_name =  "{{ tls_key_store_name }}"
type =  "JKS"
password =  "{% if secure_vault_enabled|bool %}$secret{tls_key_store_password}{% else %}{{ tls_key_store_password }}{% endif %}"
alias =  "{{ tls_key_store_key_alias }}"
key_password =  "{% if secure_vault_enabled|bool %}$secret{tls_key_store_key_password}{% else %}{{ tls_key_store_key_password }}{% endif %}"

[truststore]
file_name = "{{ trust_store_name }}"
type = "JKS"
password = "{% if secure_vault_enabled|bool %}$secret{trust_store_password}{% else %}{{ trust_store_password }}{% endif %}"

[[apim.gateway.environment]]
name = "{{apim_gw_env_name}}"
type = "{{apim_gw_env_type}}"
display_in_api_console = true
description = "This is a hybrid gateway that handles both production and sandbox token traffic."
show_as_token_endpoint_url = true
service_url = "{{apim_gw_env_service_url}}"
ws_endpoint = "{{apim_gw_env_ws_endpoint}}"
wss_endpoint = "{{apim_gw_env_wss_endpoint}}"
http_endpoint = "{{apim_gw_env_http_endpoint}}"
https_endpoint = "{{apim_gw_env_https_endpoint}}"

[apim.devportal]
url = "{{apim_devportal_url}}"

[transport.https.properties]
proxyPort = "{{https_porperties_proxyPort}}"

# Event Hub configurations
[apim.event_hub]
enable = true
username = "{{api_event_hub_username}}"
password = "{{api_event_hub_password}}"
service_url = "{{api_event_hub_service_url}}"
event_listening_endpoints = "{{api_event_hub_event_listening_endpoints}}"
event_duplicate_url = "{{api_event_hub_event_duplicate_url}}"

# [[apim.event_hub.publish.url_group]]
{% for url in [self_url, peer_url] %}
[[apim.event_hub.publish.url_group]]
urls = ["tcp://{{ url }}:9611"]
auth_urls = ["ssl://{{ url }}:9711"]
{% endfor %}

[apim.throttling]
event_duplicate_url = ["tcp://{{ throttling_peer }}:5672"]
throttle_decision_endpoints = ["tcp://localhost:5672"]

# key manager implementation
[apim.key_manager]
service_url = "{{apim.key_manager_service_url}}"
username = "{{apim.key_manager_username}}"
password = "{{apim.key_manager_password}}"
type = "default"

[[event_listener]]
id = "token_revocation"
type = "org.wso2.carbon.identity.core.handler.AbstractIdentityHandler"
name = "org.wso2.is.notification.ApimOauthEventInterceptor"
order = 1

[event_listener.properties]
notification_endpoint = "https://management.bajos.apim.coelsa.com.ar/internal/data/v1/notify"
username = "{{event_listener_username}}"
password = "{{event_listener_password}}"
'header.X-WSO2-KEY-MANAGER' = "default"

[keystore.listener_profile]
bind_address = "{{ listner_profile_key_store_bind_address }}"

{% if secure_vault_enabled|bool %}
[secrets]
admin_password = "[{{ admin_password }}]"
wso2am_db_username = "[{{ wso2am_db_username }}]"
wso2am_db_password = "[{{ wso2am_db_password }}]"
wso2shared_db_username = "[{{ wso2shared_db_username }}]"
wso2shared_db_password = "[{{ wso2shared_db_password }}]"
primary_key_store_password = "[{{ primary_key_store_password }}]"
primary_key_store_key_password = "[{{ primary_key_store_key_password }}]"
trust_store_password = "[{{ trust_store_password }}]"
internal_key_store_key_password = "[{{ internal_key_store_key_password }}]"
internal_key_store_password = "[{{ internal_key_store_password }}]"
tls_key_store_key_password = "[{{ tls_key_store_key_password }}]"
tls_key_store_password = "[{{ tls_key_store_password }}]"
{% endif %}
