[Unit]
Description=WSO2 API Manager - "Universal Gateway"
After=network.target

[Service]
Type=forking
User={{ wso2_user }}
Group={{ wso2_group }}
ExecStart={{ carbon_home }}/bin/gateway.sh start
ExecStop={{ carbon_home }}/bin/gateway.sh stop
#ExecRestart={{ carbon_home }}/bin/gateway.sh restart
#PIDFile={{ carbon_home }}/wso2carbon.pid
Restart=on-failure
RestartSec=10s
StartLimitInterval=60s
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
